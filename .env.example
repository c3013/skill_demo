# Copy this file to .env and fill in your values.
# .env is git-ignored so your secrets stay local.

# Required for Part 2 (deep-agent invocation) only.
# Part 1 (direct invocation) works without any API key.

# Option A – Anthropic (default model for deepagents):
ANTHROPIC_API_KEY=

# Option B – OpenAI:
OPENAI_API_KEY=

# Option C – Custom OpenAI-compatible endpoint (e.g. Ollama, LM Studio, Azure OpenAI):
# Set LLM_API_KEY and/or LLM_BASE_URL to enable a custom endpoint.
# LLM_MODEL_NAME sets the model name for any provider (default: gpt-4o-mini).
#
# Examples:
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL_NAME=llama3.2
#   Azure:       LLM_BASE_URL=https://<resource>.openai.azure.com/  LLM_API_KEY=<key>  LLM_MODEL_NAME=gpt-4o
#   Override model only (still uses ANTHROPIC_API_KEY / OPENAI_API_KEY for auth):
#                LLM_MODEL_NAME=anthropic:claude-3-opus-20240229
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=
